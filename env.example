# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=ml_serving_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==========================================
# Application Configuration
# ==========================================
APP_ENV=development
# ==========================================
ARTIFACT_STORAGE_BACKEND=local
LOCAL_ARTIFACT_DIR=/app/model_artifacts/

# ==========================================
# Monitoring Grafana and prometheus
# =========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_strong_password

# ==========================================
# Local runs without Docker/PostgreSQL (overrides POSTGRES_*)
# ==========================================
# DATABASE_URL=sqlite:///./msp.db

# ==========================================
# Video segmentation (SAM 2)
# ==========================================
VOS_DEVICE=cpu            # cuda on a GPU host
VOS_MAX_FRAMES=300        # guard-rail for the synchronous API
VOS_MAX_UPLOAD_MB=200
MODEL_CACHE_MAX_ITEMS=4   # LRU bound: SAM 2 checkpoints are 80 MB – 900 MB
